# Variables for known outputs
output "GIGA-BYTE TECHNOLOGY CO., LTD. Gigabyte M32Q 0x00000168" {
    alias $home1
}
output "Microstep MSI MAG241C 0x00000029" {
    alias $home2 
}
output "Dell Inc. DELL P2314H P6MV05B6518S" {
    alias $work1
}

profile home {
    output eDP-1 disable
    output $home1 mode 2560x1440@143.912Hz position 0,0
    output $home2 mode 1920x1080@144.001Hz position 2560,0
}

profile laptop {
    output eDP-1 enable mode 1920x1200@60.003Hz position 0,0
}

profile work {
    output $work1 mode 1920x1080@60.000Hz position 0,0
    output eDP-1 enable mode 1920x1200@60.003Hz position 1920,0
}
